# ═══════════════════════════════════════════════════
# Immo-Scanner — Configuration
# Copy this file to .env and edit the values below.
# ═══════════════════════════════════════════════════

# === SEARCH ZONE ===
IMMO_CITIES=Lyon,Marseille,Bordeaux,Toulouse
IMMO_DEPARTMENTS=
IMMO_RADIUS_KM=20

# === FILTERS ===
IMMO_BUDGET_MIN=30000
IMMO_BUDGET_MAX=200000
IMMO_SURFACE_MIN=15
IMMO_SURFACE_MAX=
IMMO_TYPES=apartment,house,building
IMMO_ROOMS_MIN=
IMMO_ROOMS_MAX=

# === RENTAL ESTIMATION ===
# avg_price  = built-in rent/m² database (~50 cities)
# cross_ref  = scrape rental listings to estimate real rent
# both       = avg_price baseline, enriched by cross_ref
IMMO_RENTAL_MODE=both
IMMO_MIN_YIELD=5.0

# === SCRAPING ===
# Available: leboncoin, seloger, bienici, laforet, orpi, figaro, pap
IMMO_SITES=leboncoin,seloger,bienici,laforet,orpi,figaro
IMMO_MAX_PAGES=3
IMMO_DELAY_MIN=2
IMMO_DELAY_MAX=5
IMMO_TIMEOUT=15

# === EXPORT ===
IMMO_OUTPUT_DIR=./output
IMMO_EXCEL_NAME=resultats_immo
