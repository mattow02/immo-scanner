# ═══════════════════════════════════════════════
# Immo-Scanner — Configuration
# Copier ce fichier en .env et adapter les valeurs
# ═══════════════════════════════════════════════

# === ZONE DE RECHERCHE ===
IMMO_CITIES=Lyon,Marseille,Bordeaux,Toulouse
IMMO_DEPARTMENTS=
IMMO_RADIUS_KM=20

# === FILTRES ===
IMMO_BUDGET_MIN=30000
IMMO_BUDGET_MAX=200000
IMMO_SURFACE_MIN=15
IMMO_SURFACE_MAX=
IMMO_TYPES=apartment,house,building
IMMO_ROOMS_MIN=
IMMO_ROOMS_MAX=

# === ESTIMATION LOYER ===
IMMO_RENTAL_MODE=both
IMMO_MIN_YIELD=5.0

# === SCRAPING ===
# Sites disponibles: bienici, laforet, orpi, leboncoin, seloger, figaro, pap
# Note: leboncoin et seloger peuvent être bloqués par captcha
IMMO_SITES=bienici,laforet,orpi,figaro
IMMO_MAX_PAGES=3
IMMO_DELAY_MIN=2
IMMO_DELAY_MAX=5
IMMO_TIMEOUT=15

# === EXPORT ===
IMMO_OUTPUT_DIR=./output
IMMO_EXCEL_NAME=resultats_immo
