# ═══════════════════════════════════════════════
# Immo-Scanner — Configuration
# Copier ce fichier en .env et adapter les valeurs
# ═══════════════════════════════════════════════

# === ZONE DE RECHERCHE ===
IMMO_CITIES=Lyon,Marseille,Bordeaux,Toulouse
IMMO_DEPARTMENTS=
IMMO_RADIUS_KM=20

# === FILTRES ===
IMMO_BUDGET_MIN=30000
IMMO_BUDGET_MAX=200000
IMMO_SURFACE_MIN=15
IMMO_SURFACE_MAX=
IMMO_TYPES=apartment,house,building
IMMO_ROOMS_MIN=
IMMO_ROOMS_MAX=

# === ESTIMATION LOYER ===
# avg_price = base de prix/m² intégrée (~50 villes)
# cross_ref = scrape les annonces de location pour estimer
# both      = les deux (avg_price par défaut, enrichi par cross_ref)
IMMO_RENTAL_MODE=both
IMMO_MIN_YIELD=5.0

# === SCRAPING ===
IMMO_SITES=leboncoin,seloger,pap,bienici,logicimmo,paruvendu,figaro,ouestfrance
IMMO_MAX_PAGES=5
IMMO_DELAY_MIN=2
IMMO_DELAY_MAX=5
IMMO_PROXY=
IMMO_TIMEOUT=15

# === EXPORT ===
IMMO_OUTPUT_DIR=./output
IMMO_EXCEL_NAME=resultats_immo
